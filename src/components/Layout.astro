---
import '../styles/global.css';
import SiteHeadScripts from './SiteHeadScripts.astro';
import SiteFooterScripts from './SiteFooterScripts.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Premium exterior cleaning services — driveways, siding, decks, roofs, and commercial properties.' } = Astro.props;

const logoUrl = '/images/logo.png';
const siteUrl = Astro.site?.href ?? Astro.url.origin;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'PressurePro',
  telephone: '(704) 555-0142',
  areaServed: 'Charlotte, NC',
  url: siteUrl,
  logo: logoUrl,
  image: logoUrl,
  sameAs: [
    'https://facebook.com/pressureprocharlotte',
    'https://instagram.com/pressureprocharlotte',
    'https://youtube.com/@pressureprocharlotte',
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={logoUrl} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <SiteHeadScripts />
  </head>

  <body class="antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-lime focus:text-forest focus:font-bold focus:px-4 focus:py-2 focus:rounded-lg">
      Skip to main content
    </a>
    <slot />
    <SiteFooterScripts />
  </body>
</html>
